/target
**/*.rs.bk
.DS_Store
.idea/
.vscode/

# Tauri: von tauri-build bei jedem Build neu generierte ACL-/Capability-
# Schemas, kein Repo-Inhalt (siehe apps/desktop/build.rs).
apps/*/gen/schemas/

# Trunk-Build-Ausgabe des Leptos-Frontends (apps/web), reines Build-Artefakt.
apps/web/dist/

# ESDM-CLI-Binary (lokales Tool, kein Repo-Inhalt) - NICHT die Modelldateien.
# Führender Slash bindet das an den Repo-Root, damit weder Unterverzeichnisse
# noch *.esdm.yaml-Dateien versehentlich mitgetroffen werden.
/esdm
/esdm-linux-amd64
